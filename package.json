{
  "name": "spendcraft",
  "version": "4.1.0",
  "adonis-version": "4.1.0",
  "description": "The fullstack application boilerplate for Adonisjs",
  "scripts": {
    "start": "node ace serve",
    "server-build": "NODE_ENV=production node ace build",
    "client-build": "NODE_ENV=production vite build",
    "dev-start": "node ace serve -w",
    "lint": "eslint .",
    "madge": "clear && madge -c ./client-src/App.tsx",
    "knip": "knip --config ./knip.config.json",
    "check:circular": "dpdm --transform --no-tree --no-progress --exit-code circular:1 --ignore-skip-warning '^node_modules/' -- client-src/App.tsx 'bin/*.ts' adonisrc.ts 'config/**/*.ts' 'start/**/*.ts' 'commands/**/*.ts' 'tests/**/*.spec.{js,ts}' tests/bootstrap.ts",
    "test": "node --import @poppinss/ts-exec --enable-source-maps bin/test.ts"
  },
  "madge": {
    "detectiveOptions": {
      "ts": {
        "skipTypeImports": true
      }
    }
  },
  "keywords": [
    "adonisjs",
    "adonis-app"
  ],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@adonisjs/auth": "^10.0.0",
    "@adonisjs/core": "^7.3.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/drive": "^4.0.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/mail": "^10.2.0",
    "@adonisjs/redis": "^10.0.0",
    "@adonisjs/session": "^8.0.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/vite": "^6.0.3",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@mortvola/forms": "^0.16.13",
    "@mortvola/http": "^0.1.13",
    "@mortvola/usemodal": "0.2.4",
    "@vinejs/vine": "^4.3.0",
    "argon2": "^0.44.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.11",
    "edge.js": "^6.5.0",
    "fast-xml-parser": "^5.2.5",
    "fetch-h2": "^3.0.2",
    "formik": "^2.2.9",
    "hot-hook": "^1.0.0",
    "jose": "^6.0.11",
    "js-sha256": "^1.0.0",
    "jsonwebtoken": "^9.0.0",
    "lucide-react": "^1.7.0",
    "luxon": "^3.4.4",
    "mobx": "^7.0.6",
    "mobx-react": "^10.0.2",
    "mobx-react-lite": "^5.1.0",
    "pg": "^8.7.3",
    "pg-native": "^3.0.0",
    "plaid": "^48.0.0",
    "proxy-addr": "^2.0.8",
    "react": "^19.1.0",
    "react-bootstrap": "^2.2.2",
    "react-dom": "^19.1.0",
    "react-google-charts": "^5.2.1",
    "react-plaid-link": "^5.0.0",
    "react-responsive": "^10.0.1",
    "react-router": "^8.4.0",
    "react-select": "^5.10.2",
    "reflect-metadata": "^0.2.2",
    "regenerator-runtime": "^0.14.0",
    "safe-compare": "^1.1.4",
    "typescript-eslint": "^8.55.0",
    "uuid": "^14.0.2",
    "web-push": "^3.6.6"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/eslint-config": "^3.0.0",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^2.0.0",
    "@babel/core": "^8.0.6",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@eslint/js": "9.39.5",
    "@japa/api-client": "^3.1.0",
    "@japa/assert": "^4.0.1",
    "@japa/openapi-assertions": "^0.1.1",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/luxon": "^3.6.2",
    "@types/proxy-addr": "^2.0.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/regenerator-runtime": "^0.13.1",
    "@types/safe-compare": "^1.1.2",
    "@types/web-push": "^3.6.2",
    "@vitejs/plugin-react": "^6.1.2",
    "dpdm": "^4.3.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.28.0",
    "knip": "^6.40.0",
    "madge": "^8.0.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "sass": "^1.69.5",
    "typescript": "^5.2.2",
    "vite": "^8.3.3",
    "youch": "^4.1.1"
  },
  "autoload": {
    "App": "./app"
  },
  "type": "module",
  "eslintConfig": {
    "extends": [
      "@adonisjs/eslint-config/app"
    ],
    "rules": {
      "@typescript-eslint/explicit-member-accessibility": "off",
      "unicorn/filename-case": "off",
      "@typescript-eslint/no-shadow": "off"
    }
  },
  "prettier": "@adonisjs/prettier-config",
  "imports": {
    "#controllers/*": "./app/Controllers/Http/*.js",
    "#exceptions/*": "./app/Exceptions/*.js",
    "#models/*": "./app/Models/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/Middleware/*.js",
    "#validators/*": "./app/validation/Validators/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#app/*": "./app/*.js",
    "#database/*": "./database/*.js",
    "#contracts/*": "./contracts/*.js",
    "#common/*": "./common/*.js",
    "#mails/*": "./app/mails/*.js",
    "#providers/*": "./providers/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#types/*": "./app/types/*.js"
  }
}
