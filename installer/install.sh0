#!/bin/bash

set -e
set -o pipefail

# The same installer/archive is used for both environments.
if [ "$#" -ne 1 ]; then
  echo 'Usage: install.sh staging|production' >&2
  exit 1
fi
case "$1" in
  production|staging) INSTALL_TARGET="$1" ;;
  *) echo 'Usage: install.sh staging|production' >&2; exit 1 ;;
esac

: "${SPENDCRAFT_ROOT:?Set SPENDCRAFT_ROOT to the deployment directory}"
if [ ! -d "$SPENDCRAFT_ROOT" ]; then
  echo 'Deployment directory does not exist' >&2
  exit 1
fi

confirm_deployment() {
  local expected="$1"
  local answer
  echo "$2"
  printf 'Type %s to continue: ' "$expected"
  if ! read -r answer || [ "$answer" != "$expected" ]; then
    echo 'Deployment gate declined. Keep onboarding maintenance enabled; no automatic rollback or traffic resume.' >&2
    exit 1
  fi
}

configure_nginx() {
  local root="$1"
  local template="$2"
  local target="$3"
  local config="$root/nginx.conf"
  local site=/etc/nginx/sites-enabled/spendcraft.conf
  local created_link=0

  node --input-type=module -- - "$config" "$template" "$target" <<'NGINX_CONFIG'
import { open, readFile, stat } from 'node:fs/promises'
const [config, template, target] = process.argv.slice(2)
if (!['production', 'staging'].includes(target)) throw new Error('Invalid Nginx deployment target')
try {
  if (!(await stat(config)).isFile()) throw new Error('Existing Nginx configuration is not a regular file')
  console.log('Existing shared Nginx configuration preserved.')
} catch (error) {
  if (error.code !== 'ENOENT') throw error
  const source = await readFile(template, 'utf8')
  const contents = target === 'staging' ? source.replaceAll('spendcraft.app', 'staging.spendcraft.app') : source
  const file = await open(config, 'wx', 0o644)
  try { await file.writeFile(contents); await file.sync() } finally { await file.close() }
  console.log('Created shared Nginx configuration.')
}
NGINX_CONFIG

  if sudo test -e "$site" || sudo test -L "$site"; then
    if ! sudo test -L "$site" || [ "$(sudo readlink -f -- "$site")" != "$config" ]; then
      echo "Nginx site $site already exists and does not link to $config; resolve it manually. Nothing was replaced." >&2
      return 1
    fi
  else
    sudo ln -s -- "$config" "$site"
    created_link=1
  fi
  if ! sudo nginx -t; then
    # Remove only the link created by this invocation; preserve the shared file
    # for inspection and leave pre-existing enabled sites untouched.
    if [ "$created_link" -eq 1 ]; then
      sudo rm -- "$site"
    fi
    echo 'Nginx configuration validation failed; installation stopped before migrations or release swap.' >&2
    return 1
  fi
}

ensure_app_key() {
  if node --input-type=module <<'APP_KEY_CHECK'
import { readFile } from 'node:fs/promises'
import { parseEnv } from 'node:util'
try {
  const env = parseEnv(await readFile('.env', 'utf8'))
  process.exit(env.APP_KEY ? 0 : 42)
} catch {
  console.error('Cannot read or parse .env; APP_KEY was not changed.')
  process.exit(1)
}
APP_KEY_CHECK
  then
    echo 'Existing APP_KEY preserved.'
  else
    local status=$?
    if [ "$status" -ne 42 ]; then
      return "$status"
    fi
    # The framework command writes through the shared .env symlink. Force file
    # output in production mode; never display the generated key in installer logs.
    ENV_PATH= NODE_ENV=production node ace generate:key --force
  fi
}

seed_database() {
  local answer
  while true; do
    printf 'Database seeding: type SEED to run seeders, SKIP to continue without seeding, or ABORT to stop installation: '
    if ! read -r answer; then
      echo 'No seeding decision received. Installation aborted; services remain stopped. No automatic rollback or traffic resume.' >&2
      exit 1
    fi
    case "$answer" in
      SEED|seed)
        node ace db:seed
        return
        ;;
      SKIP|skip)
        echo 'Skipping database seeding.'
        return
        ;;
      ABORT|abort)
        echo 'Installation aborted; services remain stopped. No automatic rollback or traffic resume.' >&2
        exit 1
        ;;
      *)
        echo 'Enter SEED, SKIP, or ABORT.' >&2
        ;;
    esac
  done
}

confirm_deployment DEPLOY "Confirm $INSTALL_TARGET installation: onboarding maintenance is enabled externally and will remain enabled until final verification; the selected DB target and experimental-record disposition are reviewed; cleanup keys/provider configuration are provisioned; PM2 startup recovery is installed."

SCRIPT_END=$( awk '
  BEGIN { err=1; } 
  /^\w*___END_OF_SHELL_SCRIPT___\w*$/ { print NR+1; err=0; exit 0; } 
  END { if (err==1) print "?"; }
' "$0" )

ZIP_FILE="$SPENDCRAFT_ROOT/build.zip"

echo "Checking for embedded file..."

if [ "$SCRIPT_END" == '?' ]
then
   echo Can\'t find embedded file
   exit 1
fi

if [ -e "$ZIP_FILE" ]; then
  rm "$ZIP_FILE"
fi

echo 'Extracting file to ' ${ZIP_FILE}
tail -n +"$SCRIPT_END" "$0" | base64 -d > "$ZIP_FILE"

cd "$SPENDCRAFT_ROOT"

APP=spendcraft
APP_NEW=$APP.new
APP_OLD=$APP.old

# Unpack tooling before process shutdown; no migration or application swap occurs here.
unzip "$ZIP_FILE" > /dev/null
rm -fr $APP_NEW
mv build $APP_NEW
node "$PWD/$APP_NEW/installer/managePm2.mjs" --root "$PWD" --release "$PWD/$APP_NEW" --action stop

pushd $APP_NEW

ln -s ../$APP-env .env
ln -s ../.npmrc .npmrc
if [ -f ../PushNotificationKey.p8 ]; then
  ln -s ../PushNotificationKey.p8 .
fi

#npm -dd ci --omit dev --omit optional
#npm -dd ci --omit dev --omit optional --foreground-scripts
npm ci --omit dev --omit optional

ensure_app_key
ENV_PATH= NODE_ENV=production node ace generate:web-push-keys
ENV_PATH= NODE_ENV=production node ace generate:jwt-keys
ENV_PATH= NODE_ENV=production node ace plaid:rotate-cleanup-keys --if-missing
node installer/configureInstallerEnv.mjs --target "$INSTALL_TARGET" \
  --env-file .env --requirements installer/installer.env.required.json

popd

configure_nginx "$PWD" "$PWD/$APP_NEW/installer/nginx.conf" "$INSTALL_TARGET"

bash "$SPENDCRAFT_ROOT/$APP_NEW/installer/backup.sh" \
  --env-file "$SPENDCRAFT_ROOT/$APP-env" \
  --output-parent "$SPENDCRAFT_ROOT/backups"

pushd $APP_NEW

node ace migration:status
node ace migration:run
seed_database

popd

# Keep identities outside both releases, before deleting the old rollback target or swapping directories.
node "$PWD/$APP_NEW/installer/captureDeploymentManifests.mjs" --root "$PWD" --prepare-rollback-bundle

rm -fr $APP_OLD
if [ -e $APP ]; then
  mv $APP $APP_OLD
fi
mv $APP_NEW $APP

confirm_deployment RESUME 'In another session, verify deployed cleanup configuration/readiness without contacting Plaid, PostgreSQL and Redis access, complete-ledger due/expiry counts, and PM2 reboot recovery. All deployment-managed processes remain stopped. Confirm these checks passed before starting them; keep external maintenance enabled until server and listener health checks pass after startup.'

node "$PWD/$APP/installer/managePm2.mjs" --root "$PWD" --release "$PWD/$APP" --action start
pm2 save
node "$PWD/$APP/installer/generateRollbackPlan.mjs" --root "$PWD" --target "$INSTALL_TARGET"
sudo nginx -t
sudo systemctl reload nginx
echo 'Verify server health before manually disabling external onboarding maintenance. This installer does not resume traffic.'

# Clean up
if [ -e "$ZIP_FILE" ]; then
  rm "$ZIP_FILE"
fi

exit 0

___END_OF_SHELL_SCRIPT___
